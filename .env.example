# Строка подключения Neon. В Vercel её нужно добавить как DATABASE_URL.
# Для функций берите pooled-хост: в имени есть -pooler.
# Если клиент не соединяется, уберите из строки channel_binding=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
