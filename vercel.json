{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 15,
      "includeFiles": "migrations/**"
    },
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "migrations/**"
    }
  }
}
